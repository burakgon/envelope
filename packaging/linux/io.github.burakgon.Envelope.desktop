[Desktop Entry]
Type=Application
Name=Envelope
GenericName=Mail and Calendar
Comment=Fast, beautiful mail and calendar
Exec=envelope %u
Icon=io.github.burakgon.Envelope
Terminal=false
Categories=Network;Email;Office;Calendar;
Keywords=mail;email;inbox;imap;smtp;gmail;outlook;calendar;caldav;
MimeType=x-scheme-handler/mailto;x-scheme-handler/webcal;x-scheme-handler/webcals;message/rfc822;text/calendar;text/vcard;text/x-vcard;
StartupWMClass=envelope
StartupNotify=true
Actions=compose;

[Desktop Action compose]
Name=Write a Message
Exec=envelope --compose
