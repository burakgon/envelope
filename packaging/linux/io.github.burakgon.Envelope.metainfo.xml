<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.burakgon.Envelope</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <name>Envelope</name>
  <summary>Fast, beautiful mail and calendar</summary>
  <developer id="io.github.burakgon">
    <name>Envelope contributors</name>
  </developer>
  <description>
    <p>
      Envelope is a mail and calendar app for Linux that feels instant. Everything is stored
      locally, so opening, searching and organizing mail never waits for the network.
    </p>
    <ul>
      <li>Gmail, Microsoft 365, Outlook.com, iCloud, Yahoo, Fastmail and any IMAP server</li>
      <li>Unified inbox, conversations, split inbox and lightning-fast full-text search</li>
      <li>Calendar with CalDAV, Google Calendar and Microsoft 365 support</li>
      <li>Keyboard shortcuts for everything, command palette, undo send, snooze and send later</li>
      <li>Privacy first: remote images and trackers blocked by default</li>
      <li>Optional AI assistance with your own provider (OpenRouter, OpenAI, Anthropic, Gemini, Ollama and more)</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.burakgon.Envelope.desktop</launchable>
  <url type="homepage">https://github.com/burakgon/envelope</url>
  <url type="bugtracker">https://github.com/burakgon/envelope/issues</url>
  <url type="vcs-browser">https://github.com/burakgon/envelope</url>
  <content_rating type="oars-1.1"/>
  <categories>
    <category>Network</category>
    <category>Email</category>
    <category>Office</category>
  </categories>
  <keywords>
    <keyword>mail</keyword>
    <keyword>email</keyword>
    <keyword>calendar</keyword>
    <keyword>imap</keyword>
  </keywords>
  <provides>
    <binary>envelope</binary>
    <mediatype>x-scheme-handler/mailto</mediatype>
  </provides>
  <branding>
    <color type="primary" scheme_preference="light">#b8b0ff</color>
    <color type="primary" scheme_preference="dark">#2a1f8f</color>
  </branding>
  <releases>
    <release version="0.1.0" date="2026-10-28">
      <description>
        <p>First public release.</p>
      </description>
    </release>
  </releases>
</component>
